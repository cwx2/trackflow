# ============================================================
# TrackFlow 生产环境配置模板
# 使用前：cp .env.example .env，然后修改下方配置
# 注意：.env 文件不要提交到 Git！
# ============================================================

# ===== 数据库 =====
DB_USERNAME=trackflow
DB_PASSWORD=请修改为强密码

# ===== Redis =====
REDIS_PASSWORD=请修改为强密码

# ===== MinIO 文件存储 =====
MINIO_ACCESS_KEY=trackflow
MINIO_SECRET_KEY=请修改为强密码（最少8位）

# ===== Keycloak 认证 =====
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=请修改为强密码
# Keycloak 对外访问的域名或 IP（用于 SSO 回调）
# 示例：https://auth.yourdomain.com 或 http://1.2.3.4:8080
KEYCLOAK_HOSTNAME=http://localhost:8080

# ===== 前端访问地址 =====
# 前端对外暴露的完整 URL，用于 CORS 白名单和邮件链接
# 示例：https://trackflow.yourdomain.com
FRONTEND_URL=http://localhost

# 前端监听端口（默认 80，HTTPS 场景建议用反向代理处理 443）
FRONTEND_PORT=80

# ===== 加密密钥 =====
# AES-256 密钥，Base64 编码，长度必须为 32 字节（编码后 44 字符）
# 生成方法：openssl rand -base64 32
TRACKFLOW_ENCRYPTION_KEY=请用 openssl rand -base64 32 生成并替换
