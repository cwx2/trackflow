-- V154__assign_private_field_permissions_to_roles.sql
-- 为项目管理员和技术负责人角色分配私有字段读写权限
-- 背景：issue:read_private_fields 和 issue:update_private_fields 权限码已存在于 sys_permission 表，
-- 但从未被分配给任何角色，导致 isPrivate 标记形同虚设

-- project_admin (role_id=2) 获得读取和编辑私有字段的权限
INSERT INTO role_permission (role_id, permission)
VALUES (2, 'issue:read_private_fields')
ON CONFLICT DO NOTHING;

INSERT INTO role_permission (role_id, permission)
VALUES (2, 'issue:update_private_fields')
ON CONFLICT DO NOTHING;

-- tech_lead (role_id=7) 获得读取和编辑私有字段的权限
INSERT INTO role_permission (role_id, permission)
VALUES (7, 'issue:read_private_fields')
ON CONFLICT DO NOTHING;

INSERT INTO role_permission (role_id, permission)
VALUES (7, 'issue:update_private_fields')
ON CONFLICT DO NOTHING;

-- product_manager (role_id=6) 获得读取私有字段的权限（只读）
INSERT INTO role_permission (role_id, permission)
VALUES (6, 'issue:read_private_fields')
ON CONFLICT DO NOTHING;
