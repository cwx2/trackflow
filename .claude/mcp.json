{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--viewport-size=1920x1080",
        "--output-dir=D:\\project\\YT\\test",
        "--isolated"
      ],
      "disabled": false,
      "autoApprove": [
        "browser_snapshot",
        "browser_evaluate",
        "browser_navigate",
        "browser_click",
        "browser_take_screenshot",
        "browser_find",
        "browser_console_messages",
        "browser_type",
        "browser_press_key",
        "browser_fill_form",
        "browser_close",
        "browser_resize",
        "browser_wait_for",
        "browser_network_requests",
        "browser_network_request",
        "browser_run_code_unsafe",
        "browser_navigate_back",
        "browser_select_option",
        "browser_drag",
        "browser_hover",
        "browser_tabs",
        "browser_handle_dialog",
        "browser_drop",
        "browser_file_upload"
      ]
    },
    "trackflow-test": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "D:\\project\\YT\\tools\\test-mcp",
        "trackflow-test"
      ],
      "env": {
        "TRACKFLOW_URL": "http://localhost:3000",
        "KEYCLOAK_URL": "http://localhost:8080",
        "TEST_USERNAME": "testuser",
        "TEST_PASSWORD": "test123",
        "SCREENSHOT_DIR": "D:\\project\\YT\\test",
        "VIEWPORT_WIDTH": "1440",
        "VIEWPORT_HEIGHT": "900"
      },
      "disabled": false,
      "autoApprove": [
        "list_screenshots",
        "view_screenshot",
        "build_backend",
        "restart_backend",
        "stop_backend",
        "check_compilation",
        "check_compilation_batch",
        "check_browser_available"
      ]
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-postgres-server"
      ],
      "env": {
        "PG_HOST": "localhost",
        "PG_PORT": "5432",
        "PG_USER": "trackflow",
        "PG_PASSWORD": "trackflow123",
        "PG_DATABASE": "trackflow"
      },
      "disabled": false,
      "autoApprove": [
        "query",
        "list_tables",
        "describe_table",
        "execute",
        "connect_db"
      ]
    },
    "postmancer": {
      "command": "npx",
      "args": [
        "-y",
        "postmancer"
      ],
      "env": {
        "LOG_LEVEL": "info"
      },
      "disabled": false,
      "autoApprove": [
        "http_request"
      ]
    },
    "requirement-manager": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "D:\\project\\YT\\tools\\requirement-mcp",
        "requirement-manager"
      ],
      "env": {
        "WORKSPACE": "D:\\project\\YT"
      },
      "disabled": false,
      "autoApprove": [
        "create_requirement",
        "list_requirements",
        "move_requirement",
        "get_next_number",
        "create_sub_requirement",
        "list_sub_requirements"
      ]
    }
  }
}
